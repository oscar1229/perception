{
  "input": {
    "left_image": "./assets/s0_left.jpg",
    "right_image": "./assets/s0_right.jpg"
  },
  "output": {
    "image": "./output/planar.jpg"
  },
  "camera": {
    "enable": false,
    "width": 1920,
    "height": 1080,
    "device": 0,
    "timeout_ms": 33,
    "mipi_lanes": 4,
    "mipi_mbps": 800
  },
  "registration": {
    "mode": "auto",
    "file": "",
    "save_to": "./output/calib.xml"
  },
  "feature_detection": {
    "detector": "superpoint_lightglue",
    "work_max_width": 960,
    "fast_threshold": 20,
    "max_features": 2000
  },
  "superpoint_lightglue": {
    "superpoint_model": "./assets/model/superpoint_360x640.q.onnx",
    "lightglue_model": "./assets/model/lightglue_for_superpoint_512_depth9.fp16.onnx",
    "num_keypoints": 512,
    "nms_radius": 4,
    "remove_borders": 4,
    "filter_threshold": 0.1,
    "num_threads": 4,
    "provider": "SpaceMITExecutionProvider"
  },
  "ransac": {
    "iterations": 2000,
    "threshold_px": 2.0,
    "max_reprojection_rmse_px": 2.0
  },
  "blending": {
    "num_bands": 5
  },
  "runtime": {
    "frames": 0,
    "sleep_us": 0,
    "force_offscreen": false
  }
}
